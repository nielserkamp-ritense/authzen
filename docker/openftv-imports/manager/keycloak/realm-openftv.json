{
  "realm": "openftv",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "author" },
      { "name": "auditor" },
      { "name": "user" }
    ]
  },
  "clients": [
    {
      "clientId": "openftv",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "openftv-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "openftv",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "email": "admin-user@openftv.local",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "author-user",
      "enabled": true,
      "emailVerified": true,
      "email": "author-user@openftv.local",
      "firstName": "Author",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["author"]
    },
    {
      "username": "auditor-user",
      "enabled": true,
      "emailVerified": true,
      "email": "auditor-user@openftv.local",
      "firstName": "Auditor",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["auditor"]
    }
  ]
}
