    <bpmn:sequenceFlow id="ToegewezenDienstAangepastSequenceFlow" name="Toegewezen dienst aangepast" sourceRef="Gateway_0z7p1lj" targetRef="BepalenEmailadresVanDienstTask">
                  
      
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultaatEersteBeoordeling == "TOEGEWEZEN_DIENST_AANPASSEN"}</bpmn:conditionExpression>
                
    
