  <bpmn:process camunda:historyTimeToLive="P3650D" camunda:versionTag="CD:eerstelijns-klachten:1.0.7" id="klachten-beoordelen-nieuwe-klacht" isClosed="false" isExecutable="true" name="Klachten: Beoordelen nieuwe klacht" processType="None">
            
    
    <bpmn:sequenceFlow id="Flow_08jl3wb" sourceRef="VastleggenResultaatEersteBeoordelingTask" targetRef="Gateway_0z7p1lj">
                  
      
      <bpmn:extensionElements/>
                
    
