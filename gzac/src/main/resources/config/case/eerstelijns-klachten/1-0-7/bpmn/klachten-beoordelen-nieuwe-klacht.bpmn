    <bpmn:sequenceFlow id="MeldingBetreftKlachtEnVerdereVerkenningIsBenodigdSequenceFlow" name="Melding betreft klacht en verdere verkenning is benodigd" sourceRef="Gateway_0z7p1lj" targetRef="VerdereVerkenningVanDeKlachtBenodigdEndEvent"/>
            
    
