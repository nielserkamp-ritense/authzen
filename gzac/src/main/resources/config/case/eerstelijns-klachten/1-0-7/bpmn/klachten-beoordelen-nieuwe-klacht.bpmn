    <bpmn:businessRuleTask camunda:asyncAfter="true" camunda:asyncBefore="true" camunda:decisionRef="klachten-bepalen-emailadres-van-dienst" camunda:decisionRefBinding="versionTag" camunda:decisionRefVersionTag="CD:eerstelijns-klachten:1.0.7" camunda:mapDecisionResult="singleResult" camunda:resultVariable="resultMap" completionQuantity="1" id="BepalenEmailadresVanDienstTask" implementation="##unspecified" isForCompensation="false" name="Bepalen emailadres van dienst" startQuantity="1">
                  
      
      <bpmn:extensionElements>
                        
        
        <camunda:inputOutput>
                              
          
          <camunda:inputParameter name="dienst">${documentDelegateService.findValueByJsonPointer("/rapportageCategorieen/toegewezenDienst/dienst/name", execution)}</camunda:inputParameter>
                              
          
          <camunda:outputParameter name="klachtenteam">${dienst}</camunda:outputParameter>
                              
          
          <camunda:outputParameter name="emailDienst">${resultMap.emailDienst}</camunda:outputParameter>
                            
        
        </camunda:inputOutput>
                      
      
      </bpmn:extensionElements>
                  
      
      <bpmn:incoming>ToegewezenDienstAangepastSequenceFlow</bpmn:incoming>
                  
      
      <bpmn:outgoing>Flow_0dfdv26</bpmn:outgoing>
                
    
