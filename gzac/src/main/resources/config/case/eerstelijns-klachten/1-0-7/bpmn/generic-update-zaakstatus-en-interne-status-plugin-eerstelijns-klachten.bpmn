    <bpmn:endEvent id="EndEvent">
                  
      
      <bpmn:incoming>Flow_08bna8j</bpmn:incoming>
                
    
    </bpmn:endEvent>
            
    
    <bpmn:serviceTask camunda:asyncAfter="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &quot;doc:/openZaak&quot;, openZaak)}" completionQuantity="1" id="OpslaanZaakstatusInDocumentTask" implementation="##WebService" isForCompensation="false" name="Update zaak properties in document" startQuantity="1">
                  
      
      <bpmn:extensionElements>
                        
        
        <camunda:inputOutput>
                              
          
          <camunda:inputParameter name="openZaak">
                                    
            
            <camunda:map>
                                          
              
              <camunda:entry key="identificatie">${valueResolverDelegateService.resolveValue(execution, "zaak:identificatie")}</camunda:entry>
                                          
              
              <camunda:entry key="statusOmschrijving">${valueResolverDelegateService.resolveValue(execution, "zaakstatus:omschrijving")}</camunda:entry>
                                        
            
            </camunda:map>
                                  
          
          </camunda:inputParameter>
                            
        
        </camunda:inputOutput>
                      
      
      </bpmn:extensionElements>
                  
      
      <bpmn:incoming>Flow_1alrlr1</bpmn:incoming>
                  
      
      <bpmn:outgoing>Flow_08bna8j</bpmn:outgoing>
                
    
    </bpmn:serviceTask>
          
  
  </bpmn:process>
      
  
