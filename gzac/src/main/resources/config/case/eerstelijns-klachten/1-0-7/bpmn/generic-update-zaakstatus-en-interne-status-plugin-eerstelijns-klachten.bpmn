    <bpmn:startEvent camunda:asyncAfter="true" id="StartEvent" isInterrupting="true" parallelMultiple="false">
                  
      
      <bpmn:outgoing>Flow_0wzjer7</bpmn:outgoing>
                
    
    </bpmn:startEvent>
            
    
    <bpmn:serviceTask camunda:asyncAfter="true" camunda:expression="${true}" completionQuantity="1" id="ZetZaakstatusTask" implementation="##WebService" isForCompensation="false" name="Zet zaakstatus" startQuantity="1">
                  
      
      <bpmn:incoming>Flow_081gm85</bpmn:incoming>
                  
      
      <bpmn:outgoing>Flow_1x3dopr</bpmn:outgoing>
                  
      
