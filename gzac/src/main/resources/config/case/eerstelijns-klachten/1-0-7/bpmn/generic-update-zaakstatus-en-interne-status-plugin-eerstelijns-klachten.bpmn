    </bpmn:serviceTask>
            
    
    <bpmn:serviceTask camunda:asyncAfter="true" camunda:expression="${true}" completionQuantity="1" id="OphalenZaakstatusTypeUrlTask" implementation="##WebService" isForCompensation="false" name="Ophalen zaakstatus type url" startQuantity="1">
                  
      
      <bpmn:incoming>Flow_0wzjer7</bpmn:incoming>
                  
      
      <bpmn:outgoing>Flow_081gm85</bpmn:outgoing>
                  
      
      <bpmn:property id="Property_1qwjpqj" name="__targetRef_placeholder"/>
                  
      
