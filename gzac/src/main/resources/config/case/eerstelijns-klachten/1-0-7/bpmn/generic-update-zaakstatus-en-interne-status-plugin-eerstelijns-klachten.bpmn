    <bpmn:sequenceFlow id="Flow_1alrlr1" sourceRef="ZetInterneStatusTask" targetRef="OpslaanZaakstatusInDocumentTask"/>
            
    
    <bpmn:serviceTask camunda:asyncAfter="true" camunda:expression="${documentDelegateService.setInternalStatus(execution, interneStatus)}" completionQuantity="1" id="ZetInterneStatusTask" implementation="##WebService" isForCompensation="false" name="Zet interne status" startQuantity="1">
                  
      
      <bpmn:incoming>Flow_1x3dopr</bpmn:incoming>
                  
      
      <bpmn:outgoing>Flow_1alrlr1</bpmn:outgoing>
                
    
