  <bpmn:process camunda:versionTag="CD:eerstelijns-klachten:1.0.7" id="generic-update-zaakstatus-en-interne-status-plugin-eerstelijns-klachten" isClosed="false" isExecutable="true" name="Generic: Update zaakstatus en interne status plugin eerstelijns klachten" processType="None">
            
    
